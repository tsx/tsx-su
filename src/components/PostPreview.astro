---
import type { CollectionEntry } from "astro:content";
import ReadingTime from "./ReadingTime.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, image, excerpt } = post.data;

// Extract date from filename (format: YYYY-MM-DD-slug)
const dateMatch = post.slug.match(/^(\d{4}-\d{2}-\d{2})/);
const date = dateMatch ? new Date(dateMatch[1]!) : new Date();

const formattedDate = date.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});

// Generate URL without date prefix
const urlSlug = post.slug.replace(/^\d{4}-\d{2}-\d{2}-/, "");
const postUrl = `/${urlSlug}/`;
---

<div class="post-content">
  <h2 class="!mt-0">
    <a class="post-link no-underline hover:underline" href={postUrl}>{title}</a>
  </h2>
  <span class="text-muted text-sm">
    {formattedDate}
    <ReadingTime content={post.body} />
  </span>
  {image && <img src={image} class="post-image" alt="" />}
  {excerpt && <p>{excerpt}</p>}
  <p>
    <b><a href={postUrl} class="btn btn-lg btn-primary">Read &rarr;</a></b>
  </p>
</div>
