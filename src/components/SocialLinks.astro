---
import Mail from "@lucide/astro/icons/mail";
import Linkedin from "@/components/icons/Linkedin.astro";
import X from "simple-icons-astro/X";
import Github from "simple-icons-astro/Github";
import Telegram from "simple-icons-astro/Telegram";

import {
  EMAIL,
  TWITTER_USERNAME,
  GITHUB_USERNAME,
  LINKEDIN_USERNAME,
  TELEGRAM_USERNAME,
} from "@/consts";
---

<a class="icon-link" href={`mailto:${EMAIL}`} aria-label="Email">
  <Mail class="inline-block h-5 w-5" />
</a>
<a
  class="icon-link"
  href={`https://twitter.com/${TWITTER_USERNAME}`}
  aria-label="Twitter"
>
  <X class="inline-block h-5 w-5" />
</a>
<a
  class="icon-link"
  href={`https://github.com/${GITHUB_USERNAME}`}
  aria-label="GitHub"
>
  <Github class="inline-block h-5 w-5" />
</a>
<a
  class="icon-link"
  href={`https://linkedin.com/in/${LINKEDIN_USERNAME}`}
  aria-label="LinkedIn"
>
  <Linkedin class="inline-block h-5 w-5" />
</a>
<a
  class="icon-link"
  href={`https://t.me/${TELEGRAM_USERNAME}`}
  aria-label="LinkedIn"
>
  <Telegram class="inline-block h-5 w-5" />
</a>
